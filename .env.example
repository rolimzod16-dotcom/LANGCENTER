# Скопируй в .env.local для локальной разработки
# На Vercel добавь эти же переменные в Settings → Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://твой-проект.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=твой_publishable_key
SUPABASE_SERVICE_ROLE_KEY=твой_secret_key

# Пароль входа в /admin (обязательно на Vercel!)
ADMIN_PASSWORD=придумай_надёжный_пароль

# Секрет подписи cookie-сессий (рекомендуется длинная случайная строка)
# Если не задан — используется ADMIN_PASSWORD (хуже, но работает)
SESSION_SECRET=придумай_длинный_случайный_секрет_32plus

# Публичный URL сайта (для Telegram webhook и ссылок в ботах)
APP_URL=https://langcenter-tillojon.vercel.app

# Контакты на лендинге
NEXT_PUBLIC_CONTACT_PHONE=+992 90 100 04 44
NEXT_PUBLIC_CONTACT_PHONE_TEL=+992901000444
NEXT_PUBLIC_CONTACT_EMAIL=hello@langcenter.tj
NEXT_PUBLIC_CONTACT_ADDRESS=г. Душанбе
NEXT_PUBLIC_CONTACT_WHATSAPP=992901000444

# ---------- Telegram (два бота) ----------
# 1) Бот заявок + админ/руководитель — создай через @BotFather
TELEGRAM_ADMIN_BOT_TOKEN=
# 2) Бот учеников — второй бот через @BotFather
TELEGRAM_STUDENT_BOT_TOKEN=
# 3) Бот учителей — оценки и посещаемость в Telegram
TELEGRAM_TEACHER_BOT_TOKEN=
# Общий secret для webhook (любая длинная строка)
TELEGRAM_WEBHOOK_SECRET=случайная_строка_webhook
# Опционально: chat_id админов через запятую (можно вместо /auth)
# Узнать id: напиши боту, потом /auth, или @userinfobot
TELEGRAM_ADMIN_CHAT_IDS=
